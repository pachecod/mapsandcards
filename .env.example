# PostgreSQL connection string (provided by Render automatically)
DATABASE_URL=postgresql://user:pass@host:5432/mapsandcards
DATABASE_SSL=true

# Backblaze B2 (optional — needed for future media uploads)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_BUCKET_ID=

# App password for the full editor and admin panel (leave blank to disable).
# Protects /Tools/scroll-map-builder.html (without ?guest=1), /admin, and story
# create/save/delete/export. Guest Mode and story viewing stay public.
APP_PASSWORD=

# STUDENT_AUTH_REQUIRED=true — require student login for builder (Guest Mode still public)
STUDENT_AUTH_REQUIRED=

# Optional: comma-separated origins allowed to call /api/platform/v1 with credentials
# (for future webxride.com integration). Example: https://webxride.com,https://www.webxride.com
PLATFORM_CORS_ORIGINS=

# Optional session secrets (defaults derived from APP_PASSWORD in dev)
# ADMIN_SESSION_SECRET=
# STUDENT_SESSION_SECRET=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable. Served via /__analytics.js on Vite and production.
GOOGLE_ANALYTICS_ID=

# Server port (Render sets PORT automatically)
PORT=3000
