    {
      "id": "location-5",
      "lat": 43.075995717846325,
      "lng": -76.2180520174735,
      "zoom": 12.518011325379986,
      "html": "<p>This large lake is Onondaga Lake. The Haudenosaunee Native Americans consider this lake sacred as the location of <span style=\"color: rgba(0, 0, 0, 0.96);\">founding of the Haudenosaunee Confederacy. The Peacemaker brought the five warring nations together on the shores of Onondaga Lake, buried weapons at the Tree of Peace, and united them under the Great Law of Peace.</span></p>",
      "flyTransition": "smooth",
      "overlays": {
        "geojson": {
          "type": "FeatureCollection",
          "features": [
            {
              "type": "Feature",
              "properties": {
                "kind": "label",
                "showDot": true,
                "color": "#f0f0f0",
                "haloColor": "#0f1419",
                "radius": 21,
                "text": "Onondaga Lake",
                "dotColor": "#3388ff"
              },
              "geometry": {
                "type": "Point",
                "coordinates": [
                  -76.2103617062728,
                  43.08949876402281
                ]
